# Archivos de entorno
.env

# Configuración local de VS Code (personal, no se comparte)
.vscode/

# Archivos de certificados y claves privadas
*.pem

# Archivos comprimidos
*.gz
*.zip

# Archivos de texto temporales o de respaldo
# (No usar *.txt genérico: excluiría requirements.txt y otros archivos de proyecto)

# Directorios de entornos virtuales
venv/
env/
.virtualenv/

# Caché de Python
__pycache__/
*.pyc
*.pyo


# Archivos de base de datos MySQL (backups y dumps)
*.sql.gz
dump_*.sql


# Archivos de respaldo y copias
*-Copy.py
*-Backup.py
*.bak

# Archivos de log
*.log

# Querys de MySQL: por defecto no se versionan (dumps/exports ad-hoc,
# backups pesados) -- pero los scripts de DDL puntuales que documentamos
# como fuente de verdad (triggers, fixes de datos) si se versionan.
querys/*
*.sql
!querys/ddl_app_login_auditoria_api.sql
!querys/fix_trigger_alm_producto_after_insert.sql
!querys/fix_trigger_alm_producto_after_update.sql
!querys/fix_12_productos_atascados_produccion.sql
!querys/fix_barcode_vacio_a_null.sql
!querys/create_views_pourcost.sql
